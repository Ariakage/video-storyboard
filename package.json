{
  "name": "video-storyboard-skill",
  "version": "1.1.0",
  "description": "Agent Skill: turn a video into storyboard images you can cite — one frame per shot, cell size follows cut density (1/1 … 1/8), row-packed into as few images as possible, with a timestamped index and a text locator.",
  "keywords": [
    "agent-skill",
    "skill",
    "claude-code",
    "video",
    "storyboard",
    "contact-sheet",
    "shot-detection",
    "scene-detection",
    "ffmpeg",
    "multimodal",
    "asr"
  ],
  "homepage": "https://github.com/Ariakage/video-storyboard#readme",
  "bugs": {
    "url": "https://github.com/Ariakage/video-storyboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ariakage/video-storyboard.git"
  },
  "author": "SAOS-3624",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/storyboard/index.js",
  "exports": {
    ".": "./src/storyboard/index.js",
    "./plan": "./src/storyboard/plan.js",
    "./scan": "./src/storyboard/scan.js",
    "./segments": "./src/storyboard/segments.js",
    "./probe": "./src/storyboard/probe.js",
    "./sheet": "./src/storyboard/sheet.js",
    "./frames": "./src/storyboard/frames.js",
    "./format": "./src/storyboard/format.js",
    "./pipeline": "./src/storyboard/pipeline.js",
    "./storyboard": "./src/storyboard/index.js",
    "./board": "./src/storyboard/board.js",
    "./cache": "./src/storyboard/cache.js",
    "./storage": "./src/storyboard/storage.js",
    "./locate": "./src/storyboard/locate.js",
    "./subtitles": "./src/storyboard/subtitles.js",
    "./subtitle-strip": "./src/storyboard/subtitle-strip.js",
    "./ytdlp": "./src/storyboard/ytdlp.js",
    "./python": "./src/storyboard/python.js",
    "./browser-time": "./src/storyboard/browser-time.js",
    "./transcript-pass": "./src/storyboard/transcript-pass.js",
    "./config": "./src/storyboard/config.js"
  },
  "bin": {
    "video-storyboard": "./bin/storyboard.mjs",
    "video-probe": "./bin/probe.mjs",
    "video-zoom": "./bin/zoom.mjs",
    "video-locate": "./bin/locate.mjs",
    "video-subtitles": "./bin/subtitles.mjs",
    "video-doctor": "./bin/doctor.mjs",
    "video-scan": "./bin/scan-video.mjs",
    "video-asr-check": "./bin/asr-check.mjs"
  },
  "files": [
    "SKILL.md",
    "references",
    "src",
    "bin",
    "scripts",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "CREDITS.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node scripts/guard-publish.mjs && npm test",
    "check": "node scripts/check-syntax.mjs",
    "doctor": "node bin/doctor.mjs",
    "asrcheck": "node bin/asr-check.mjs",
    "guard": "node scripts/guard-publish.mjs",
    "install-skill": "node scripts/install-skill.mjs",
    "verify-tokens": "node scripts/verify-image-tokens.mjs"
  }
}
